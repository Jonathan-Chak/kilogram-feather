---
import Layout from "../../components/Layout.astro";
import { supabase } from "../../utils/database";
import Image from "astro/components/Image.astro";

export const prerender = false;

const { id } = Astro.params;

if (!id) {
  throw new Error("No framework id provided");
}

// Fetch pet data from Supabase if connection is set up
let framework;
if (supabase) {
  const { data, error } = await supabase
    .from("frameworks")
    .select("*")
    .eq("id", id)
    .single();
  framework = data ? data : null;
  if (error || !framework) {
    console.error(error);
    throw new Error("No framework found");
  }
}
 let image_array = framework.showcase?.split(',')||"";

---
<Layout title={`${framework?.name}`}>
  <article class="border-b pb-14 border-neutral-600">
    
    <header
      class="flex items-center  pb-2 mb-8 border-b"
    >
      <img
        src={`/.netlify/images?url=/images/${framework?.logo}`}
        alt={framework?.name}
        class="mb-4 w-12 max-w-12"
      />
      <h1 class="mb-4 mx-2 w-fit text-5xl font-bold">{framework?.name}</h1>
      
    </header>
    <div class="flex -space-x-64">
      {image_array.map((image:string) => (
        <div onmouseenter=onenter(this) class="image-containter" >
          <img class="w-md aspect-video object-cover bg-blue-200 border"
           src={`/.netlify/images?url=/images/${image}`}
           />
        </div>
      ))}
    </div>
    <figure>
      
    </figure>

    <p class="py-6 text-xl">{framework?.description}</p>
  <div class="w-full text-right">
    <a href={framework.url} class=" px-4 py-2 font-bold text-lg bg-linear-90 from-blue-500 to-gray-800 rounded-2xl border-2 border-blue-500 hover:to-blue-500">
      		⏵Check it out
    </a>
  </div>
  </article>

</Layout>

<script is:inline>
  let image_containers =[];
  image_containers = document.querySelectorAll('.image-containter');
  
  window.onenter = function(element){
    image_containers.forEach(container => {
      container.classList.remove('z-50')
    });
    if (element){
      element.classList.add('z-50')
    }
  }

</script>