---
import Layout from "../../components/Layout.astro";
import { supabase } from "../../utils/database";

export const prerender = false;

const { id } = Astro.params;

if (!id) {
  throw new Error("No framework id provided");
}

// Fetch pet data from Supabase if connection is set up
let framework;
if (supabase) {
  const { data, error } = await supabase
    .from("projects")
    .select("*")
    .eq("id", id)
    .single();
  framework = data ? data : null;
  if (error || !framework) {
    console.error(error);
    throw new Error("No framework found");
  }
}
---

<Layout title={`${framework?.name}`}>
  <article class="border-b pb-14 border-neutral-600">
    <header
      class="flex flex-wrap items-center justify-between pb-2 mb-8 border-b"
    >
      <h1 class="mb-4 text-5xl font-bold">{framework?.name}</h1>
    </header>

    <figure>
      <img
        src={`/.netlify/images?url=/images/pastImages/${framework?.content}`}
        alt={framework?.name}
        class="mb-2 border rounded-sm border-neutral-500"
      />
      <figcaption class="font-mono text-xs">{framework?.name}</figcaption>
    </figure>

    <p class="pt-6 text-xl">{framework?.description}</p>

    <form action={`/api/frameworks/${framework?.id}/like3Dpost`} method="post" style="padding-top: 15px;" class="flex">
      <button type="submit" class="px-4 rounded-full text-2xl text-neutral-100 hover:bg-orange-600">🡅</button>
      <p class="m-2">
        {framework?.likes}
      </p>
      <button onclick="this.textContent='downvoting not allowed'" onmouseleave="this.textContent='🡇'" type=reset class="px-4 rounded-full text-2xl text-neutral-100 hover:bg-blue-600">🡇</button>
    </form>
  </article>
</Layout>
