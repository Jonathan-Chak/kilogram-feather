---
import Details from "./Details.astro";

const { framework } = Astro.props;
---

<div class="square border-0 border-gray-700 shadow-2xl shadow-black p-5 cursor-help" id={framework.id.toString()}>
    <img
      src={`/.netlify/images?url=/images/${framework.logo}`}
      class="w-62"
      alt={framework.name}
    />
    <div class="text-xl font-bold">
      {framework.name}
      <br>
      {framework.likes} vote{framework.likes === 1 ? "" : "s"}
    </div>
    
</div>

<div></div>
