---
import { getEntry } from "astro:content";
import Alert from "../components/Alert.astro";
import Guide from "../components/Guide.astro";
import Layout from "../components/Layout.astro";
import TableRow from "../components/TableRow.astro";
import { supabase } from "../utils/database";
import Details from "../components/Details.astro";

export const prerender = false;

let frameworks;
let frameworksError;

// Fetch frameworks data from Supabase if connection is set up
if (supabase) {
  const { data, error } = await supabase
    .from("frameworks")
    .select("*")
    .order("likes", { ascending: false });
  frameworks = data;
  frameworksError = error;
}
---

<Layout title="Kilogram Feather">
  <h1 class="mb-8 text-xl font-bold border-b border-gray-400 pb-2">
    What I'm learning
  </h1>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    {frameworks?.map((framework) => (
        <TableRow framework={framework} />
      
    ))}
    <Details framework={frameworks}/>
  </div>
  
</Layout>
<script is:inline>
  const squares = document.querySelectorAll('.square');

  squares.forEach((element,index) => {
    element.addEventListener('click',()=>{
      const id = element.id;
      console.log("selected game "+id);
      element.classList.add('font-bold');
      element.classList.add('bg-blue-900/60');
      window.location.href = '/frameworks/'+id
    })
    element.addEventListener('mouseenter',()=>{
      const id = element.id;
      element.classList.add('bg-gray-700');
      const rect = element.getBoundingClientRect();
      const event = new CustomEvent('ui:show-details',{detail:{id:id,rect:rect,sorted_id:index}});
      window.dispatchEvent(event)
      

    element.addEventListener('mouseleave',()=>{
      const id = element.id;
      element.classList.remove('bg-gray-700');
      const event = new CustomEvent('ui:hide-details',{detail:{id:id}});
      window.dispatchEvent(event)
    })
  });
});
</script>